# Supabase Connection Settings
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct Connection String (Used for DB migrations via Supabase CLI)
# Find this in Supabase Project Settings -> Database -> Connection string (URI) / Session mode
SUPABASE_DB_URL=postgresql://postgres.xyzcompany:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Bootstrap Administrator
# When a user registers with this email address, they will automatically be granted role = 'admin' and status = 'approved'
BOOTSTRAP_ADMIN_EMAIL=admin@exemplu.ro
